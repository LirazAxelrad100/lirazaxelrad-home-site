# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

# Resend API key, used by the contact form (app/api/contact/route.ts) to send email.
# Create a free account at https://resend.com and generate a key.
RESEND_API_KEY=

# Used to build absolute URLs in sitemap.xml / robots.txt. Set once the site
# has a real domain; defaults to https://lirazaxelrad.com if unset.
NEXT_PUBLIC_SITE_URL=https://lirazaxelrad.com
