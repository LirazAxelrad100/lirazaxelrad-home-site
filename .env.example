# Copy this file to .env and fill in real values. .env is git-ignored.

# Resend API key, used by the contact form (src/pages/api/contact.ts) to send email.
# Create a free account at https://resend.com and generate a key.
RESEND_API_KEY=

# Used to build absolute URLs in sitemap.xml. Set once the site has a real
# domain; defaults to https://lirazaxelrad.com if unset.
PUBLIC_SITE_URL=https://lirazaxelrad.com

# Signs the approve/decline links in booking request emails, so only links
# this site generated are accepted. Any long random string works, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOKING_SECRET=
