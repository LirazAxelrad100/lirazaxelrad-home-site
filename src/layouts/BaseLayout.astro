---
import HtmlShell from "./HtmlShell.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { SiteData } from "../data/types";

interface Props {
  site: SiteData;
  title: string;
  description: string;
  alternateHref: string | null;
  image?: string;
  ogType?: "website" | "article";
  jsonLd?: unknown;
  noindex?: boolean;
}

const { site, title, description, alternateHref, image, ogType, jsonLd, noindex } = Astro.props;
---

<HtmlShell
  lang={site.locale}
  dir={site.dir}
  title={title}
  description={description}
  alternateHref={alternateHref}
  image={image}
  ogType={ogType}
  jsonLd={jsonLd}
  noindex={noindex}
>
  <div class="flex min-h-screen flex-col font-heebo">
    <Header name={site.name} tagline={site.tagline} homeHref={site.homeHref} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer nameLabel={site.name} footer={site.footer} />
  </div>
</HtmlShell>
