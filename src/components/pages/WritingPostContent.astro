---
import type { SiteData, WritingPost } from "../../data/types";

interface Props {
  site: SiteData;
  post: WritingPost;
  writingBasePath: string;
}

const { site, post, writingBasePath } = Astro.props;
const arrow = site.dir === "rtl" ? "→" : "←";
---

<article class="mx-auto max-w-[680px] px-[6vw] pb-24 pt-14">
  <a href={writingBasePath} class="text-[14px] no-underline">
    {arrow} {site.writing.allPostsLabel}
  </a>
  <div class="mb-2.5 mt-6 text-[13px] tracking-[0.5px] text-accent">{post.date}</div>
  <h1 class="m-0 mb-8 font-rubik text-[clamp(28px,4vw,40px)] font-medium leading-[1.3]">{post.title}</h1>
  <div class="text-[18px] leading-[1.9] text-text-body">
    {post.body.map((paragraph) => (
      <p class="m-0 mb-[22px] last:mb-0">{paragraph}</p>
    ))}
  </div>
</article>
