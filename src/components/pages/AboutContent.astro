---
import type { SiteData } from "../../data/types";

interface Props {
  site: SiteData;
}

const { about } = Astro.props.site;
const arrow = Astro.props.site.dir === "rtl" ? "←" : "→";
---

<section class="mx-auto max-w-[640px] px-[6vw] pb-10 pt-16">
  <h1 class="m-0 mb-5 font-david-libre text-[clamp(28px,3.5vw,38px)] font-medium">{about.title}</h1>
  {about.intro.map((paragraph) => (
    <p class="m-0 mb-[18px] text-[17px] leading-[1.85] text-text-body last:mb-0">{paragraph}</p>
  ))}
</section>

<section class="mx-auto max-w-[900px] px-[6vw] pb-24 pt-10">
  <h2 class="m-0 mb-7 font-david-libre text-[24px] font-medium">{about.whatIDoTitle}</h2>
  <div class="flex flex-col gap-7">
    {about.whatIDoItems.map((item) => (
      <div>
        <h3 class="m-0 mb-2 text-[17px]">{item.title}</h3>
        <p class="m-0 text-[15px] leading-[1.75] text-text-body-soft">{item.body}</p>
      </div>
    ))}
  </div>
  <a href={about.ctaHref} class="mt-9 inline-block text-[15px] font-semibold no-underline">
    {about.ctaLabel} {arrow}
  </a>
</section>
