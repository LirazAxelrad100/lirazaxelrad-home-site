---
import { marked } from "marked";

interface Props {
  title: string;
  paragraphs: string[];
  image?: string;
}

const { title, paragraphs, image } = Astro.props;
---

<div class="flex flex-1 flex-col items-stretch gap-6 px-[6vw] pb-24 pt-4 md:flex-row">
  <div class="hidden flex-shrink-0 md:block md:w-[260px]" aria-hidden="true"></div>
  <section
    class="flex-1 self-start p-9 text-[17px] leading-[1.85] text-text-body md:max-w-[680px] [&_ul]:mb-[18px] [&_ul]:list-disc [&_ul]:ps-6 [&_ul>li]:mb-2 [&_p]:mb-[18px] [&_p:last-child]:mb-0 [&_strong]:font-semibold [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:opacity-80"
  >
    <h1 class="m-0 mb-5 font-rubik text-[clamp(28px,3.5vw,38px)] font-medium">{title}</h1>
    {paragraphs.map((paragraph) => <Fragment set:html={marked.parse(paragraph)} />)}
    {image && (
      <img
        src={image}
        alt={title}
        class="mx-auto mt-9 block h-64 w-64 rounded-full object-cover"
      />
    )}
  </section>
</div>
