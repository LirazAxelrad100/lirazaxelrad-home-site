---
import { ContactTabs } from "../ContactTabs";
import type { SiteData } from "../../data/types";

interface Props {
  site: SiteData;
}

const { contact, booking, locale } = Astro.props.site;
---

<section class="mx-auto max-w-[640px] px-[6vw] pb-24 pt-16">
  <h1 class="m-0 mb-3.5 font-rubik text-[clamp(28px,3.5vw,38px)] font-medium">{contact.title}</h1>
  <p class="m-0 mb-10 text-[16px] leading-[1.7] text-text-muted">{contact.intro}</p>

  <ContactTabs client:load booking={booking} contact={contact} locale={locale} />

  {/* Both tabs need JavaScript to work, so without it the panel would sit on
      "loading" forever. Leave a way to reach Liraz that always works. */}
  <noscript>
    <p class="m-0 mt-6 text-[15px] leading-[1.7] text-text-muted">
      <a href={`mailto:${contact.directEmailLabel}`} class="text-accent">{contact.directEmailLabel}</a>
    </p>
  </noscript>
</section>
