---
interface Props {
  name: string;
  tagline: string;
  homeHref: string;
}

const { name, tagline, homeHref } = Astro.props;
---

<div class="px-[6vw] pt-10 md:pt-6">
  <div class="flex flex-col gap-0">
    <a href={homeHref} class="text-accent no-underline">
      <h1 class="m-0 font-rubik text-[clamp(36px,6vw,64px)] font-extralight leading-none tracking-[0.5px]">{name}</h1>
    </a>
    <span class="text-[16px] leading-none text-text-muted-soft">{tagline}</span>
  </div>
</div>
