---
import { getCollection } from "astro:content";
import HtmlShell from "../../layouts/HtmlShell.astro";
import { HomeMenu } from "../../components/HomeMenu";
import Footer from "../../components/Footer.astro";
import { en } from "../../data/site.en";
import { buildMenuItems, firstParagraph } from "../../lib/menu";
import { sortPostsByDateDesc } from "../../lib/writing";
import { profilePageSchema, siteOrigin } from "../../lib/seo";

const entries = await getCollection("menuEn");
const items = buildMenuItems(entries);
const origin = siteOrigin(Astro.site);

// The homepage panel for "Writing" shows the newest blog post instead of
// its own static teaser text, so it stays current as new posts are added.
const [newestPost] = sortPostsByDateDesc(await getCollection("writingEn"));
const writingItem = items.find((item) => item.key === "writing");
if (newestPost && writingItem) {
  writingItem.title = newestPost.data.title;
  writingItem.body = firstParagraph(newestPost.body ?? "");
}
---

<HtmlShell
  lang={en.locale}
  dir={en.dir}
  title={`${en.name} — ${en.tagline}`}
  description={en.description}
  alternateHref="/"
  jsonLd={profilePageSchema(en, origin)}
>
  <div class="flex h-screen flex-col">
    <HomeMenu client:load name={en.name} tagline={en.tagline} homeHref={en.homeHref} dir={en.dir} items={items} />
    <Footer nameLabel={en.name} footer={en.footer} compact />
  </div>
</HtmlShell>
