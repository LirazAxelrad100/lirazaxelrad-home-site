---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WritingListContent from "../../../../components/pages/WritingListContent.astro";
import { en } from "../../../../data/site.en";
import { allTags, slugifyTag, sortPostsByDateDesc } from "../../../../lib/writing";

export async function getStaticPaths() {
  const posts = await getCollection("writingEn");
  return allTags(posts).map(({ slug, label }) => ({
    params: { tag: slug },
    props: {
      label,
      posts: sortPostsByDateDesc(posts.filter((post) => post.data.tags.some((tag) => slugifyTag(tag) === slug))),
    },
  }));
}

const { label, posts } = Astro.props;
---

<BaseLayout
  site={en}
  title={`#${label} — ${en.writing.title} — ${en.name}`}
  description={en.description}
  alternateHref="/writing"
>
  <WritingListContent site={en} writingBasePath="/en/writing" posts={posts} activeTagLabel={label} />
</BaseLayout>
