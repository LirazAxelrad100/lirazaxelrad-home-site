---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WritingPostContent from "../../components/pages/LegacyWritingPostContent.astro";
import { he } from "../../data/site.he";

export function getStaticPaths() {
  return (he.writing.posts ?? []).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
---

<BaseLayout
  site={he}
  title={`${post.title} — ${he.name}`}
  description={he.description}
  alternateHref={null}
  noindex
>
  <WritingPostContent site={he} post={post} writingBasePath="/writing" />
</BaseLayout>
