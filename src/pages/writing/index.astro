---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WritingListContent from "../../components/pages/LegacyWritingListContent.astro";
import { he } from "../../data/site.he";
---

<BaseLayout
  site={he}
  title={`${he.writing.title} — ${he.name}`}
  description={he.description}
  alternateHref={null}
  noindex
>
  <WritingListContent site={he} writingBasePath="/writing" />
</BaseLayout>
